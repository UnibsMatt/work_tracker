# Login for the site (used on the login page)
APP_USER=silvana
APP_PASSWORD=change-me
# Optional: random string used to sign the login cookie
# (changing it logs everyone out). Defaults to one derived from the password.
SESSION_SECRET=

# Timezone used by the server
TZ=Europe/Paris

# Pay rules: each shift is split by percentage between two rates.
# With 4h @ 10€ and 3h @ 12€, 4/7 (57%) of every hour is paid 10€/h
# and 3/7 (43%) is paid 12€/h. A 7h shift = 4*10 + 3*12 = 76€.
PAY_HOURS_A=4
PAY_RATE_A=10
PAY_HOURS_B=3
PAY_RATE_B=12

# Optional: only used with `docker compose --profile tunnel up -d`
CLOUDFLARE_TUNNEL_TOKEN=
